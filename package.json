{
  "name": "erp-platform",
  "version": "6.1.0-wave10-completion",
  "private": true,
  "description": "Enterprise Modular ERP & Executive BI — Wave 0 Foundation",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run",
    "test:bundle": "tsx tools/load-test/bundle-size.ci.ts",
    "test:marketing-bundle": "tsx tools/load-test/marketing-bundle.ci.ts",
    "test:watch": "vitest",
    "lint": "eslint \"packages/**/*.ts\" \"apps/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "pnpm --filter @repo/domain build && pnpm --filter @repo/db-core-adapter build && pnpm --filter @repo/module-sdk build && pnpm --filter @repo/observability build && pnpm --filter @repo/api typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "tsx tools/prisma-cli.ts packages/db-platform db push --accept-data-loss",
    "db:push:all": "tsx tools/db-push-all.ts",
    "db:seed": "tsx tools/run-seed-with-env.ts packages/db-platform/prisma/seed.ts",
    "db:seed:erp": "tsx tools/run-seed-with-env.ts packages/db-erp-finance/prisma/seed-demo.ts && tsx tools/run-seed-with-env.ts packages/db-erp-operations/prisma/seed-crm-demo.ts",
    "db:seed:hr": "tsx tools/run-seed-with-env.ts packages/db-erp-hr/prisma/seed-hr-demo.ts",
    "test:e2e:visual:update": "playwright test e2e/visual-dashboard.spec.ts --update-snapshots",
    "db:generate:all": "tsx tools/db-generate-all.ts",
    "db:generate:platform": "tsx tools/prisma-cli.ts packages/db-platform generate",
    "test:e2e:smoke": "playwright test e2e/smoke-rtl.spec.ts",
    "test:e2e:estimate": "playwright test e2e/estimate-checkout.spec.ts",
    "test:e2e:marketing": "playwright test -c playwright.marketing.config.ts",
    "test:e2e:projects": "playwright test -c playwright.projects.config.ts",
    "test:e2e:projects:prepare": "pnpm --filter @repo/web build",
    "smoke:wms-sales": "tsx tools/smoke/wms-sales-api.smoke.ts",
    "test:e2e:visual": "playwright test e2e/visual-dashboard.spec.ts",
    "lighthouse:ci": "lhci autorun --config=tools/lighthouse/lighthouserc.json",
    "migrate": "pnpm --filter @repo/migration-engine migrate -- --dry-run --source=csv --target=postgres",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@playwright/test": "^1.49.1",
    "@lhci/cli": "^0.14.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
