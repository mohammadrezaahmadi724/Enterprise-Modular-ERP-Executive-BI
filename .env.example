# =============================================================================
# متغیرهای محیطی پلتفرم ERP — Wave 0
# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید.
# =============================================================================

# PostgreSQL — اتصال اصلی (چند schema: platform, platform_outbox, erp_*)
# نام دیتابیس: erp_platform — جدول‌ها در schemaهای platform و platform_outbox (نه public خالی)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/erp_platform?schema=platform
# Redis master محلی (BullMQ + کش) — اگر نصب نیست API در حالت in-memory کار می‌کند
REDIS_URL=redis://127.0.0.1:6379

# حداکثر اتصال‌های Pool — روی cPanel معمولاً ۱۰ یا کمتر
PG_POOL_MAX=10

# REDIS_URL برای Production الزامی است — cPanel/LiteSpeed معمولاً Redis محلی ندارد؛
# از Upstash یا سرور مجزا استفاده کنید. در dev خالی = حافظه درون‌پردازه + هشدار کنسول.
REDIS_URL=

# پورت API (NestJS)
PORT=3000

# توکن داخلی برای Cron داخلی
CRON_SECRET_TOKEN=change-me-in-production

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=erp-api

# Sentry (اختیاری)
SENTRY_DSN=

# JWT (Wave 1+ — برای middleware آزمایشی Wave 0)
JWT_SECRET=dev-only-change-in-production

# Break-Glass TTL (ساعت)
BREAK_GLASS_TTL_HOURS=4

# محیط اجرا
NODE_ENV=development

# Wave 5 — Webhooks / KMS / Migration / Backup
N8N_WEBHOOK_SECRET=change-me-n8n-hmac-secret
WEBHOOK_IP_WHITELIST=127.0.0.1,::1
KMS_MASTER_KEY=change-me-32-char-minimum-master-key
KMS_KEY_VERSION=v1
MIGRATION_TENANT_ID=11111111-1111-4111-8111-111111111111
BACKUP_DIR=.data/backups
BACKUP_S3_BUCKET=
BACKUP_FTP_URL=

# Wave 6 — Email / Notifications
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
GMAIL_OAUTH_CLIENT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WEB_URL=http://127.0.0.1:3001
# همان پلن برای لینک چک‌اوت از برآوردگر (مارکتینگ + web)
NEXT_PUBLIC_CLOUD_PLAN_CODE=professional
# پلن اشتراک ابری برای برآوردگر مارکتینگ (modulePrices در features پلن)
CLOUD_PLAN_CODE=professional
# OTP برآورد — none = فقط لاگ dev؛ http = وب‌هوک SMS
ESTIMATE_OTP_SMS_PROVIDER=none
# none | http | kavenegar
ESTIMATE_OTP_SMS_URL=
ESTIMATE_OTP_SMS_API_KEY=
ESTIMATE_OTP_SMS_TEMPLATE=کد تأیید برآورد: {{code}}
# OTP برآورد — ذخیره در Redis با REDIS_URL (چند نمونه API)
ESTIMATE_OTP_SEND_COOLDOWN_SEC=60
ESTIMATE_OTP_SEND_MAX_PER_HOUR=8
ESTIMATE_OTP_VERIFY_MAX_ATTEMPTS=8
KAVENEGAR_API_KEY=
# اگر در پنل کاوه‌نگار قالب lookup دارید؛ وگرنه sms/send با متن بالا
KAVENEGAR_OTP_TEMPLATE=
NEXT_PUBLIC_MARKETING_URL=http://127.0.0.1:3003
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google OAuth (Wave 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/google/callback
WEB_APP_URL=http://127.0.0.1:3001

# Wave 9 — Persistence ERP روی PostgreSQL
FINANCE_PERSISTENCE=true
CRM_PERSISTENCE=true
WMS_PERSISTENCE=true
# همراه WMS یا QC_PERSISTENCE=true برای qc_inspections از PostgreSQL
# QC_PERSISTENCE=true
HR_PERSISTENCE=true
# true = فایل JSON (PROJECTS_STORE_DIR) + هم‌نوشت Prisma erp_operations (پروژه/کار)
PROJECTS_PERSISTENCE=false
# PROJECTS_STORE_DIR=.data/projects-store
# true = جداول erp_master_records و erp_tenant_branding (پیش‌فرض: همراه PROJECTS_PERSISTENCE)
# MASTER_DATA_PERSISTENCE=false
# فایل‌های برندینگ tenant (لوگو/مهر/امضا) — پیش‌فرض: .data/tenant-objects
# OBJECT_STORAGE_ROOT=
# BRANDING_UPLOAD_MAX_BYTES=2097152
# BRANDING_UPLOAD_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif
# MinIO / S3-compatible (در صورت تنظیم، local نادیده گرفته می‌شود)
# OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_BUCKET=erp-tenant-assets
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_SSL=false
RLS_ENABLED=true
# اختیاری — تطبیق tenantId در mutationهای Prisma پلتفرم وقتی TenantContext ست است
PLATFORM_PRISMA_CONTEXT_GUARD=false
# کاربر مدیر سازمان دمو برای BFF tenant (بدون super-admin)
NEXT_PUBLIC_TENANT_ADMIN_USER_ID=00000000-0000-4000-8000-000000000099
WMS_ADJUSTMENT_QTY_THRESHOLD=100
WMS_STOCKTAKING_VARIANCE_TOMAN_THRESHOLD=5000000
# تأیید workflow — مبالغ به تومان
PROCUREMENT_PR_APPROVAL_TOMAN_THRESHOLD=50000000
PROCUREMENT_PO_APPROVAL_TOMAN_THRESHOLD=100000000
AUTH_DB_ENABLED=true
AUTH_PERMISSIONS_DB=true

# Wave 9 — SMTP / KMS / Backup
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
KMS_KEY_VERSION=v1
KMS_MASTER_KEY=
BACKUP_POLICY=daily-pg-dump
BACKUP_LAST_RUN=

# Production — Redis اجباری برای Worker/BullMQ
# REDIS_URL=redis://...

# E2E Playwright
# E2E_BASE_URL=http://127.0.0.1:3001
# E2E_MARKETING_URL=http://127.0.0.1:3003
# E2E_API_URL=http://127.0.0.1:3000
# E2E_FULL_STACK=1
