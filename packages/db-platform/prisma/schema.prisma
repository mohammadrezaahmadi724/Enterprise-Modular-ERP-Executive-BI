generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "platform_outbox"]
}

enum EventStatus {
  Pending
  Published
  Consumed
  Failed
  Dead

  @@schema("platform_outbox")
}

enum TenantStatus {
  Active
  Suspended
  Trial
  Churned

  @@schema("platform")
}

enum ModuleActivationStatus {
  Active
  Inactive
  Pending

  @@schema("platform")
}

model DomainEventOutbox {
  id               String      @id @default(uuid())
  eventId          String      @unique @map("event_id")
  eventType        String      @map("event_type")
  schemaVersion    Int         @map("schema_version")
  aggregateId      String      @map("aggregate_id")
  aggregateVersion Int         @map("aggregate_version")
  payload          Json
  tenantId         String      @map("tenant_id")
  correlationId    String      @map("correlation_id")
  causationId      String?     @map("causation_id")
  sourceSchema     String      @map("source_schema")
  status           EventStatus @default(Pending)
  publishedAt      DateTime?   @map("published_at")
  consumedAt       DateTime?   @map("consumed_at")
  retryCount       Int         @default(0) @map("retry_count")
  errorMessage     String?     @map("error_message")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([tenantId, aggregateId])
  @@map("domain_events_outbox")
  @@schema("platform_outbox")
}

model IdempotencyKey {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  idempotencyKey       String    @map("idempotency_key")
  endpoint             String
  requestHash          String    @map("request_hash")
  responseStatus       Int?      @map("response_status")
  responseBody         Json?     @map("response_body")
  responseReferenceId  String?   @map("response_reference_id")
  lockedUntil          DateTime? @map("locked_until")
  expiresAt            DateTime  @map("expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, idempotencyKey, endpoint])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("platform")
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  region      String       @default("ir")
  status      TenantStatus @default(Trial)
  trialEndsAt DateTime?    @map("trial_ends_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  users         User[]
  auditLogs     AuditLog[]
  tenantModules TenantModule[]
  moduleFlags   ModuleFlag[]
  subscription  Subscription?
  trials        TenantTrial[]
  breakGlass    BreakGlassRequest[]

  @@map("tenants")
  @@schema("platform")
}

model User {
  id               String    @id @default(uuid())
  tenantId         String?   @map("tenant_id")
  email            String    @unique
  passwordHash     String    @map("password_hash")
  fullName         String    @map("full_name")
  isSuperAdmin     Boolean   @default(false) @map("is_super_admin")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")
  googleId         String?   @map("google_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastLoginAt      DateTime? @map("last_login_at")

  tenant   Tenant?            @relation(fields: [tenantId], references: [id])
  sessions UserSession[]
  userRoles UserRoleAssignment[]

  @@index([tenantId])
  @@map("users")
  @@schema("platform")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  ip               String
  userAgent        String    @map("user_agent")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
  @@schema("platform")
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String? @map("tenant_id")
  code        String
  name        String
  permissions Json
  assignments UserRoleAssignment[]

  @@unique([tenantId, code])
  @@map("roles")
  @@schema("platform")
}

model UserRoleAssignment {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_role_assignments")
  @@schema("platform")
}

enum BreakGlassStatus {
  Pending
  Approved
  Rejected
  Expired

  @@schema("platform")
}

model BreakGlassRequest {
  id                  String           @id @default(uuid())
  tenantId            String           @map("tenant_id")
  requesterId         String           @map("requester_id")
  approverId          String?          @map("approver_id")
  reason              String
  status              BreakGlassStatus @default(Pending)
  breakGlassSessionId String?          @map("break_glass_session_id")
  expiresAt           DateTime?        @map("expires_at")
  createdAt           DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("break_glass_requests")
  @@schema("platform")
}

enum PricingModel {
  Flat
  PerSeat
  Tiered
  Volume
  Usage
  Custom

  @@schema("platform")
}

enum BillingSubscriptionStatus {
  Trial
  Active
  PastDue
  Canceled
  Expired

  @@schema("platform")
}

enum InvoiceStatus {
  Draft
  Issued
  Paid
  Void
  Refunded

  @@schema("platform")
}

enum PaymentStatus {
  Pending
  Succeeded
  Failed
  Refunded

  @@schema("platform")
}

enum RefundStatus {
  Pending
  Approved
  Rejected
  Completed

  @@schema("platform")
}

enum DiscountType {
  Percent
  Fixed

  @@schema("platform")
}

enum SerialResetPeriod {
  Yearly
  Monthly
  Never

  @@schema("platform")
}

model Plan {
  id          String   @id @default(uuid())
  code        String   @unique
  nameFa      String   @map("name_fa")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  versions PlanVersion[]

  @@map("plans")
  @@schema("platform")
}

model PlanVersion {
  id            String       @id @default(uuid())
  planId        String       @map("plan_id")
  version       Int
  pricingModel  PricingModel @map("pricing_model")
  basePrice     Decimal      @map("base_price") @db.Decimal(18, 2)
  currency      String       @default("IRR")
  features      Json
  limits        Json
  effectiveFrom DateTime     @map("effective_from")
  effectiveTo   DateTime?    @map("effective_to")
  createdAt     DateTime     @default(now()) @map("created_at")

  plan        Plan          @relation(fields: [planId], references: [id])
  featuresRel PlanFeature[]
  limitsRel   PlanLimit[]
  subs        Subscription[]

  @@unique([planId, version])
  @@map("plan_versions")
  @@schema("platform")
}

model PlanFeature {
  id            String @id @default(uuid())
  planVersionId String @map("plan_version_id")
  featureKey    String @map("feature_key")
  featureValue  String @map("feature_value")

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id])

  @@map("plan_features")
  @@schema("platform")
}

model PlanLimit {
  id            String @id @default(uuid())
  planVersionId String @map("plan_version_id")
  limitKey      String @map("limit_key")
  limitValue    String @map("limit_value")

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id])

  @@map("plan_limits")
  @@schema("platform")
}

model Subscription {
  id                 String                    @id @default(uuid())
  tenantId           String                    @unique @map("tenant_id")
  planVersionId      String                    @map("plan_version_id")
  planSnapshot       Json                      @map("plan_snapshot")
  status             BillingSubscriptionStatus @default(Trial)
  currentPeriodStart DateTime                  @map("current_period_start")
  currentPeriodEnd   DateTime                  @map("current_period_end")
  seats              Int                       @default(1)
  usedSeats          Int                       @default(0) @map("used_seats")
  version            Int                       @default(0)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  planVersion PlanVersion           @relation(fields: [planVersionId], references: [id])
  history     SubscriptionHistory[]
  invoices    Invoice[]

  @@map("subscriptions")
  @@schema("platform")
}

model SubscriptionHistory {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  changeType     String   @map("change_type")
  oldSnapshot    Json     @map("old_snapshot")
  newSnapshot    Json     @map("new_snapshot")
  changedBy      String   @map("changed_by")
  changedAt      DateTime @default(now()) @map("changed_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_history")
  @@schema("platform")
}

model Invoice {
  id                     String        @id @default(uuid())
  tenantId               String        @map("tenant_id")
  subscriptionId         String?       @map("subscription_id")
  invoiceNumber          String        @map("invoice_number")
  serialPattern          String        @map("serial_pattern")
  issueDate              DateTime      @map("issue_date")
  dueDate                DateTime      @map("due_date")
  status                 InvoiceStatus @default(Draft)
  subtotal               Decimal       @db.Decimal(18, 2)
  taxAmount              Decimal       @map("tax_amount") @db.Decimal(18, 2)
  discountAmount         Decimal       @map("discount_amount") @db.Decimal(18, 2)
  total                  Decimal       @db.Decimal(18, 2)
  currency               String        @default("IRR")
  exchangeRateSnapshot   Json          @map("exchange_rate_snapshot")
  planSnapshot           Json          @map("plan_snapshot")
  correlationId          String        @map("correlation_id")
  createdAt              DateTime      @default(now()) @map("created_at")

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
  @@schema("platform")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 2)
  taxRate     Decimal @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_items")
  @@schema("platform")
}

model Payment {
  id                     String        @id @default(uuid())
  tenantId               String        @map("tenant_id")
  invoiceId              String        @map("invoice_id")
  amount                 Decimal       @db.Decimal(18, 2)
  currency               String
  exchangeRateSnapshot   Json          @map("exchange_rate_snapshot")
  gateway                String
  gatewayReference       String?       @map("gateway_reference")
  status                 PaymentStatus @default(Pending)
  paidAt                 DateTime?     @map("paid_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  idempotencyKey         String        @map("idempotency_key")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@map("payments")
  @@schema("platform")
}

model Refund {
  id                   String       @id @default(uuid())
  tenantId             String       @map("tenant_id")
  paymentId            String       @map("payment_id")
  amount               Decimal      @db.Decimal(18, 2)
  reason               String
  exchangeRateSnapshot Json         @map("exchange_rate_snapshot")
  status               RefundStatus @default(Pending)
  approvedBy           String?      @map("approved_by")
  processedAt          DateTime?    @map("processed_at")

  @@map("refunds")
  @@schema("platform")
}

model InvoiceSerialPattern {
  id          String            @id @default(uuid())
  tenantId    String?           @map("tenant_id")
  pattern     String
  lastNumber  Int               @default(0) @map("last_number")
  resetPeriod SerialResetPeriod @map("reset_period")

  @@map("invoice_serial_patterns")
  @@schema("platform")
}

model CustomerWallet {
  id       String  @id @default(uuid())
  tenantId String  @unique @map("tenant_id")
  balance  Decimal @db.Decimal(18, 2)
  currency String  @default("IRR")
  version  Int     @default(0)

  @@map("customer_wallets")
  @@schema("platform")
}

model TenantTrial {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  fingerprintHash String    @map("fingerprint_hash")
  startedAt       DateTime  @default(now()) @map("started_at")
  endsAt          DateTime  @map("ends_at")
  blockedAt       DateTime? @map("blocked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([fingerprintHash])
  @@map("tenant_trials")
  @@schema("platform")
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique
  description String

  @@map("permissions")
  @@schema("platform")
}

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  ip            String
  correlationId String   @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
  @@schema("platform")
}

model SensitiveAccessLog {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  superAdminId        String   @map("super_admin_id")
  approverId          String   @map("approver_id")
  reason              String
  breakGlassSessionId String   @map("break_glass_session_id")
  grantedAt           DateTime @map("granted_at")
  expiresAt           DateTime @map("expires_at")
  accessedResources   Json     @map("accessed_resources")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([tenantId, breakGlassSessionId])
  @@map("sensitive_access_logs")
  @@schema("platform")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
  @@schema("platform")
}

model TenantModule {
  id            String                 @id @default(uuid())
  tenantId      String                 @map("tenant_id")
  moduleCode    String                 @map("module_code")
  version       String
  status        ModuleActivationStatus @default(Pending)
  activatedAt   DateTime?              @map("activated_at")
  deactivatedAt DateTime?              @map("deactivated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleCode])
  @@map("tenant_modules")
  @@schema("platform")
}

model ModuleFlag {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  moduleCode String  @map("module_code")
  flagKey    String  @map("flag_key")
  flagValue  Boolean @map("flag_value")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleCode, flagKey])
  @@map("module_flags")
  @@schema("platform")
}

model ErpScreenRecord {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  screenKey String   @map("screen_key")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, screenKey])
  @@map("erp_screen_records")
  @@schema("platform")
}

model SupportTicket {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  subject   String
  priority  String   @default("normal")
  status    String   @default("open")
  category  String   @default("support")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@map("support_tickets")
  @@schema("platform")
}

model PlatformFeatureFlag {
  id          String  @id @default(uuid())
  flagKey     String  @unique @map("flag_key")
  description String  @default("")
  rollout     Int     @default(100)
  enabled     Boolean @default(true)

  @@map("platform_feature_flags")
  @@schema("platform")
}
