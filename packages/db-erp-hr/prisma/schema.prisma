generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["erp_hr"]
}

enum EmployeeStatus {
  Active
  OnLeave
  Terminated

  @@schema("erp_hr")
}

enum LeaveRequestStatus {
  Draft
  PendingApproval
  Approved
  Rejected

  @@schema("erp_hr")
}

model Employee {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  employeeNumber String         @map("employee_number")
  fullName       String         @map("full_name")
  nationalId     String         @map("national_id")
  birthDate      DateTime       @map("birth_date")
  phone          String?
  email          String?
  address        String?
  hireDate       DateTime       @map("hire_date")
  status         EmployeeStatus @default(Active)
  createdAt      DateTime       @default(now()) @map("created_at")

  leaveRequests       LeaveRequest[]
  attendanceRecords   AttendanceRecord[]
  contracts           EmployeeContract[]

  @@unique([tenantId, employeeNumber])
  @@map("employees")
  @@schema("erp_hr")
}

model OrganizationalUnit {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  code     String
  nameFa   String  @map("name_fa")
  parentId String? @map("parent_id")

  parent   OrganizationalUnit?  @relation("OrgTree", fields: [parentId], references: [id])
  children OrganizationalUnit[] @relation("OrgTree")
  positions Position[]

  @@unique([tenantId, code])
  @@map("organizational_units")
  @@schema("erp_hr")
}

model Position {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  code      String
  nameFa    String @map("name_fa")
  orgUnitId String @map("org_unit_id")

  orgUnit OrganizationalUnit @relation(fields: [orgUnitId], references: [id])

  @@unique([tenantId, code])
  @@map("positions")
  @@schema("erp_hr")
}

enum AttendanceStatus {
  Present
  Absent
  Leave
  Holiday

  @@schema("erp_hr")
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  tenantId   String           @map("tenant_id")
  employeeId String           @map("employee_id")
  date       DateTime         @db.Date
  checkIn    DateTime?        @map("check_in")
  checkOut   DateTime?        @map("check_out")
  status     AttendanceStatus @default(Present)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, date])
  @@map("attendance_records")
  @@schema("erp_hr")
}

enum ContractStatus {
  Active
  Expired
  Terminated

  @@schema("erp_hr")
}

model EmployeeContract {
  id         String         @id @default(uuid())
  tenantId   String         @map("tenant_id")
  employeeId String         @map("employee_id")
  startDate  DateTime       @map("start_date")
  endDate    DateTime?      @map("end_date")
  salaryBase Decimal        @map("salary_base") @db.Decimal(18, 2)
  currency   String         @default("IRR")
  status     ContractStatus @default(Active)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_contracts")
  @@schema("erp_hr")
}

model LeaveRequest {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  employeeId    String             @map("employee_id")
  type          String
  startDate     DateTime           @map("start_date")
  endDate       DateTime           @map("end_date")
  status        LeaveRequestStatus @default(Draft)
  correlationId String             @map("correlation_id")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("leave_requests")
  @@schema("erp_hr")
}

enum PayslipStatus {
  Draft
  Finalized

  @@schema("erp_hr")
}

model PayrollRule {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  code          String
  nameFa        String    @map("name_fa")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  config        Json

  @@unique([tenantId, code, effectiveFrom])
  @@map("payroll_rules")
  @@schema("erp_hr")
}

model TaxBracket {
  id             String  @id @default(uuid())
  country        String  @default("IR")
  effectiveYear  Int     @map("effective_year")
  minIncome      Decimal @map("min_income") @db.Decimal(18, 2)
  maxIncome      Decimal? @map("max_income") @db.Decimal(18, 2)
  rate           Decimal @db.Decimal(5, 4)

  @@map("tax_brackets")
  @@schema("erp_hr")
}

model InsuranceRule {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  effectiveFrom DateTime @map("effective_from")
  effectiveTo  DateTime? @map("effective_to")
  employeeRate Decimal   @map("employee_rate") @db.Decimal(5, 4)
  employerRate Decimal   @map("employer_rate") @db.Decimal(5, 4)
  ceiling      Decimal   @db.Decimal(18, 2)

  @@map("insurance_rules")
  @@schema("erp_hr")
}

model PayslipSnapshot {
  id                 String        @id @default(uuid())
  tenantId           String        @map("tenant_id")
  employeeId         String        @map("employee_id")
  periodStart        DateTime      @map("period_start")
  periodEnd          DateTime      @map("period_end")
  baseSalary         Decimal       @map("base_salary") @db.Decimal(18, 2)
  overtime           Decimal       @default(0) @db.Decimal(18, 2)
  nightShift         Decimal       @default(0) @map("night_shift") @db.Decimal(18, 2)
  holidays           Decimal       @default(0) @db.Decimal(18, 2)
  commission         Decimal       @default(0) @db.Decimal(18, 2)
  insuranceEmployee  Decimal       @map("insurance_employee") @db.Decimal(18, 2)
  insuranceEmployer  Decimal       @map("insurance_employer") @db.Decimal(18, 2)
  tax                Decimal       @db.Decimal(18, 2)
  netPay             Decimal       @map("net_pay") @db.Decimal(18, 2)
  breakdown          Json
  status             PayslipStatus @default(Draft)
  finalizedAt        DateTime?     @map("finalized_at")
  adjustmentReason   String?       @map("adjustment_reason")
  correlationId      String        @map("correlation_id")
  supersededById     String?       @map("superseded_by_id")

  @@index([tenantId, employeeId, periodStart])
  @@map("payslip_snapshots")
  @@schema("erp_hr")
}

model EmployeeCommission {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  employeeId    String   @map("employee_id")
  sourceType    String   @map("source_type")
  sourceId      String   @map("source_id")
  amount        Decimal  @db.Decimal(18, 2)
  accruedAt     DateTime @map("accrued_at")
  paidInPayslipId String? @map("paid_in_payslip_id")

  @@map("employee_commissions")
  @@schema("erp_hr")
}
